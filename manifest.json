{
  "manifest_version": 3,
  "name": "Google Antigravity Frame Color",
  "version": "1.1.0",
  "description": "Sets the window frame (title bar) and launch splash color for the Google Antigravity Remote Control Chrome Web App.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://antigravity.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Antigravity Frame Color",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://antigravity.google.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
