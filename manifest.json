{
  "manifest_version": 3,
  "name": "Google Antigravity Frame Color",
  "version": "1.3.0",
  "description": "Automatically synchronizes the window frame (title bar) and launch splash color with the Google Antigravity Remote Control Web App.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://antigravity.google.com/*",
    "https://antigravity.static.usercontent.goog/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://antigravity.google.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://antigravity.static.usercontent.goog/*"
      ],
      "js": [
        "src/shared.js",
        "src/iframe-observer.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
